# Copiá como .env para scripts locales (opcional).
# En el navegador usá js/config.js (ver js/config.example.js).
#
# Vercel (Settings → Environment Variables):
#   SUPABASE_URL       → https://TU_PROYECTO.supabase.co
#   SUPABASE_ANON_KEY  → sb_publishable_... (Publishable / anon key)
# El deploy ejecuta npm run build y genera js/config.js automáticamente.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# NUNCA en frontend ni en Git:
# SUPABASE_SERVICE_ROLE_KEY=
